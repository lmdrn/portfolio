# Copy to .env.local for local dev, and add the same variables in Vercel → Project → Settings → Environment Variables

# Contact form (https://resend.com → API Keys)
RESEND_API_KEY=
# Inbox that receives the messages
CONTACT_TO_EMAIL=leamedrano@gmail.com
# Optional: sender once a domain is verified in Resend, e.g. "Portfolio <contact@leamedrano.com>"
# CONTACT_FROM_EMAIL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics and the cookie banner.
NEXT_PUBLIC_GA_ID=
